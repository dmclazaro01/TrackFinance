# ─── TrackFinance environment variables ───────────────────────────
# Copy to .env.local for local dev, and set the same keys in Vercel.

# PostgreSQL connection string (Neon, Vercel Postgres, Supabase, etc.)
# For serverless, use the POOLED connection string.
DATABASE_URL="postgresql://user:password@host:5432/trackfinance?sslmode=require"

# Auth.js secret — generate with:  npx auth secret   (or  openssl rand -base64 33)
AUTH_SECRET="replace-with-a-long-random-string"

# Google OAuth credentials (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID="your-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-client-secret"

# Optional: only needed if auto host detection fails (Auth.js trusts the host by default).
# AUTH_URL="https://your-app.vercel.app"

# Secret for the daily property re-valuation cron (Vercel Cron sends it as a
# Bearer token). Generate any long random string. Optional in local dev.
CRON_SECRET="replace-with-a-long-random-string"
