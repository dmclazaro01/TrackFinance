# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
/docs/
/.claude/
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client (regenerated on install via postinstall)
/src/generated/prisma

# hallmark skill run logs (regenerated per project)
/.hallmark

# Prisma auto-installed agent skills (regenerated by prisma; triplicated across tools)
/.agents
/.windsurf
/skills-lock.json
/.claude/skills/prisma-*

# agent tooling files (AGENTS.md is regenerated by `next dev`; CLAUDE.md just imports it)
/AGENTS.md
/CLAUDE.md

# local editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# claude local overrides (keep shared skills + launch.json)
.claude/settings.local.json

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# logs & runtime junk
*.log
logs/
*.pid
*.seed
